# Copy these names into the Railway Variables dashboard. Do not commit a real .env file.
NODE_ENV=production
# Railway provides PORT automatically.
CALVING_LOG_DB=/data/calving-log.db
CALVING_LOG_OWNER_PASSWORD=replace-with-a-unique-long-password
CALVING_LOG_VET_PASSWORD=replace-with-a-unique-long-password
CALVING_LOG_MILKER_PASSWORD=replace-with-a-unique-long-password
# Optional external intent recognition. Keep the real key in Railway Variables.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
AI_ENABLED=true
# Combined limit for queries + connection tests, UTC day; resets on server restart.
# Request safeguard only, not a provider monetary cap. 0 blocks paid calls.
AI_DAILY_REQUEST_LIMIT=200
# For the alternative provider, set AI_PROVIDER=openai and OPENAI_API_KEY.
